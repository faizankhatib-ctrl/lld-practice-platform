# Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration
# Set USE_IN_MEMORY_DB=true to run without an external MongoDB server
MONGODB_URI=mongodb://localhost:27017/lld_practice_platform
USE_IN_MEMORY_DB=true

# Evaluator Engine Configuration
# When AI_EVALUATOR_ENABLED=true, server uses GeminiAiEvaluator if GEMINI_API_KEY is present
AI_EVALUATOR_ENABLED=false
# Optional model override (defaults to gemini-1.5-flash)
AI_MODEL=gemini-1.5-flash

# AI API Configuration (Keep secret; not exposed to client)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
